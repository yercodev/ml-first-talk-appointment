      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const plan = $('Plan').first().json;\nconst links = plan.requests.filter(function (r) { return r.kind === 'role'; }).map(function (r) { return { bookingId: r.link.bookingId, discordUserId: r.link.discordUserId, roleOk: true }; });\nconst results = plan.requests.filter(function (r) { return r.kind === 'notification'; }).map(function (r) { return { notificationId: r.notificationId, ok: true }; }).concat(plan.failed);\nreturn [{ json: { payload: { dryRun: true, membersListed: plan.membersListed, links: links, presence: plan.presence, results: results } } }];"
      }
