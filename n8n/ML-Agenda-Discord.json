    {
      "id": "71ebfe35-8a48-420e-92ee-7e25e47622bf",
      "name": "Armar ack 1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        440
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const plan = $('Plan').first().json;\n// Los resultados llegan en el mismo orden que los pedidos. Si no hubo pedidos, solo hay avisos fallidos que confirmar.\nconst res = $('Enviar a Discord').isExecuted ? $input.all().map(function (i) { return i.json; }) : [];\nconst links = [];\nconst results = plan.failed.slice();\nplan.requests.forEach(function (p, idx) {\n  const r = res[idx] || {};\n  const st = r.statusCode;\n  const ok = st >= 200 && st < 300;\n  const err = ok ? undefined : 'Discord ' + (st || 'sin respuesta');\n  const retry = r.body && r.body.retry_after ? Math.ceil(r.body.retry_after) : undefined;\n  if (p.kind === 'role') links.push({ bookingId: p.link.bookingId, discordUserId: p.link.discordUserId, roleOk: ok, error: err });\n  else results.push({ notificationId: p.notificationId, ok: ok, error: err, retryAfterSeconds: retry });\n});\nreturn [{ json: { payload: { dryRun: false, membersListed: plan.membersListed, links: links, presence: plan.presence, results: results } } }];"
      }
    },
