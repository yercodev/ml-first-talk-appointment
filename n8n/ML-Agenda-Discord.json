        "jsCode": "const p2 = $('Armar fase 2').first().json;\nconst res = $('Enviar fase 2').isExecuted ? $input.all().map(function (i) { return i.json; }) : [];\nconst results = p2.failed.slice();\np2.requests.forEach(function (p, idx) {\n  const r = res[idx] || {};\n  const ok = r.statusCode >= 200 && r.statusCode < 300;\n  results.push({ notificationId: p.notificationId, ok: ok, error: ok ? undefined : 'Discord ' + (r.statusCode || 'sin respuesta'), retryAfterSeconds: r.body && r.body.retry_after ? Math.ceil(r.body.retry_after) : undefined });\n});\nif (!results.length) return [];\n// Este ack solo confirma envios: sin presencia real no se afirma nada (membersListed: false).\nreturn [{ json: { payload: { dryRun: false, membersListed: false, links: [], presence: [], results: results } } }];"
