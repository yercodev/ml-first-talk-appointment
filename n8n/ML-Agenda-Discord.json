    {
      "id": "8cd6b59c-6b36-4e4f-ad1e-06728f191d6a",
      "name": "Plan final (no se envia nada)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const plan = $('Plan').first().json;\nconst ack = $input.first().json;\nconst lines = [];\nplan.requests.forEach(function (r) {\n  if (r.kind === 'role') lines.push('rol ML-temp → ' + r.link.discordUsername + ' (' + r.link.discordUserId + ')');\n  if (r.kind === 'notification') lines.push(r.where + ': ' + r.body.content);\n});\nplan.failed.forEach(function (f) { lines.push('[fallaria] aviso ' + f.notificationId + ': ' + f.error); });\n(ack.notifications || []).forEach(function (n) {\n  lines.push('[tras el ack] ' + (n.target.type === 'dm' ? 'DM a Yerco' : '#ml-temp') + ': ' + n.content);\n});\nreturn [{ json: { dryRun: true, miembrosListados: plan.membersListed, plan: lines, limpieza: $('Pendiente').first().json.cleaned } }];"
      }
    },
