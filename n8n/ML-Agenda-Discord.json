    {
      "id": "327038a1-7b06-4c52-838a-a0f824ac784a",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const pend = $('Pendiente').first().json;\n// Canal de DM de Yerco. Si no se pudo abrir (dm = null), esos avisos se marcan como fallidos (dm_unavailable)\n// directamente en el ack, sin hacer ninguna peticion; los roles y los mensajes a #ml-temp siguen su curso.\nlet dm = 'dry-run-dm';\nif ($('Abrir DM de Yerco').isExecuted) {\n  const d = $('Abrir DM de Yerco').first().json;\n  dm = d && d.id ? d.id : null;\n}\nlet members = [];\nlet listed = false;\nif ($('Miembros').isExecuted) {\n  members = $('Miembros').all().map(function (i) { return i.json; });\n  listed = members.length > 0 && members.every(function (m) { return m.user && !m.error; });\n}\n// Se compara el nombre de USUARIO (nunca el visible) y se ignoran los bots.\nconst byName = {};\nconst byId = {};\nmembers.forEach(function (m) {\n  if (!m.user || m.user.bot) return;\n  byName[String(m.user.username).toLowerCase()] = m.user.id;\n  byId[m.user.id] = true;\n});\nconst base = 'https://discord.com/api/v10';\nconst requests = [];\nconst failed = [];\npend.linkCandidates.forEach(function (c) {\n  const uid = listed ? byName[c.discordUsername] : undefined;\n  if (!uid) return;\n  requests.push({ kind: 'role', where: 'rol ML-temp', method: 'PUT', url: base + '/guilds/' + pend.config.guildId + '/members/' + uid + '/roles/' + pend.config.roleId, reason: 'Primera charla agendada (' + c.bookingId + ')', link: { bookingId: c.bookingId, discordUserId: uid, discordUsername: c.discordUsername } });\n});\nconst presence = listed ? pend.presenceChecks.map(function (p) { return { bookingId: p.bookingId, present: !!byId[p.discordUserId] }; }) : [];\npend.notifications.forEach(function (n) {\n  if (n.target.type === 'dm' && !dm) {\n    failed.push({ notificationId: n.id, ok: false, error: 'dm_unavailable' });\n    return;\n  }\n  const body = { content: n.content, allowed_mentions: n.allowedMentions };\n  if (n.flags) body.flags = n.flags;\n  const channel = n.target.type === 'dm' ? dm : n.target.id;\n  requests.push({ kind: 'notification', where: n.target.type === 'dm' ? 'DM a Yerco' : '#ml-temp', notificationId: n.id, method: 'POST', url: base + '/channels/' + channel + '/messages', body: body });\n});\nreturn [{ json: { membersListed: listed, presence: presence, requests: requests, failed: failed } }];"
      }
    },
